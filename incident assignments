SELECT
    i.incident_id,
    sa.analyst_name,
    ia.assignment_date,
    inv.investigation_date,
    inv.findings,
    ra.action_description,
    ra.action_date
FROM incidents i
JOIN Incident_Assignments ia
    ON i.incident_id = ia.incident_id
JOIN security_analysts sa
    ON ia.analyst_id = sa.analyst_id
JOIN investigation inv
    ON i.incident_id = inv.incident_id
JOIN Response_Actions ra
    ON i.incident_id = ra.incident_id;

